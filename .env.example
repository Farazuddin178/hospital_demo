# Copy to .env.local for local dev, and set the same keys in your host's
# environment variable settings for production (Vercel/Netlify/etc.).
# Never commit .env.local — it's already covered by .gitignore.

# Public (safe to expose to the browser — NOT secrets, just identifiers):
NEXT_PUBLIC_GA_ID=

# Server-only secrets (NEVER prefix these with NEXT_PUBLIC_, never import them
# into client components — only read inside API routes / Server Components):
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
APPOINTMENTS_TO_EMAIL=
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
